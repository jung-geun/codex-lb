# Application source is pinned by gateway/UPSTREAM_REVISION; Docker base images are digest-pinned.
# Always verify an isolated database migration before production deployment.
LOCAL_IMAGE=codex-lb-local:1.25.0b9-api-fallback

# Keep ports on loopback; use a TLS reverse proxy on the backend network for remote clients.
CODEX_LB_BIND_ADDRESS=127.0.0.1
