# Copy to .env.llm and choose a unique strong dashboard password before startup.
INITIAL_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
# Gateway encryption/authentication secrets are independently generated in llm-pieroot-data.
LLM_IMAGE=llm-pieroot:3.8.52-pieroot2
LLM_DASHBOARD_PORT=20148
LLM_API_PORT=20149
LLM_BUILD_MEMORY_MB=16384
